<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net48</TargetFramework>
    <AssemblyName>RustLauncher</AssemblyName>
    <RootNamespace>RustLauncher</RootNamespace>
    <Product>Rust Launcher</Product>
    <Version>1.0.0</Version>
    <ApplicationIcon>app.ico</ApplicationIcon>
    <ApplicationManifest>app.manifest</ApplicationManifest>
    <DebugType>none</DebugType>
    <AppendTargetFrameworkToOutputPath>false</AppendTargetFrameworkToOutputPath>
    <!-- Use the .NET Framework 4.8 targeting pack installed on this PC instead of downloading it -->
    <AutomaticallyUseReferenceAssemblyPackages>false</AutomaticallyUseReferenceAssemblyPackages>
  </PropertyGroup>

  <ItemGroup>
    <Reference Include="System.Windows.Forms" />
  </ItemGroup>

  <!-- This project builds the WinForms RustLauncher.exe from Program.cs only.
       WpfLauncher.cs (the primary RustOriginLauncher.exe, built with csc via make_release.ps1) and
       Launcher.cs (an older standalone WinForms downloader) each declare their own Main()
       and must not be compiled in; SDK-style projects otherwise glob every .cs in the folder. -->
  <ItemGroup>
    <Compile Remove="WpfLauncher.cs" />
    <Compile Remove="Launcher.cs" />
  </ItemGroup>

</Project>
