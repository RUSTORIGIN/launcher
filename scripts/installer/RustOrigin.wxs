<?xml version="1.0" encoding="UTF-8"?>
<!--
  WiX (v4+/v7) source for the RustOrigin Launcher MSI.

  Per-user install (no admin / no UAC): the launcher goes into
  %LOCALAPPDATA%\Programs\RustOrigin Launcher\ with Start Menu + Desktop shortcuts and an
  Add/Remove Programs entry. Only the ~7 MB single-file launcher is installed; it downloads
  and SHA-256-verifies the game client itself at runtime.

  Build with scripts\build_msi.ps1 (which first builds release\RustOrigin.exe via make_release.ps1).
  The MSI version is bound from the exe's file version, so bump it through make_release.ps1 -Version.

  The UpgradeCode below is STABLE and must never change - it is how Windows recognizes newer
  builds as upgrades of the same product.
-->
<Wix xmlns="http://wixtoolset.org/schemas/v4/wxs">
  <Package Name="RustOrigin Launcher"
           Manufacturer="RustOrigin"
           Version="!(bind.FileVersion.RustOriginExe)"
           UpgradeCode="5C476A54-DD8A-4419-899B-A53AA4FCE177"
           Scope="perUser"
           Compressed="yes">

    <MajorUpgrade DowngradeErrorMessage="A newer version of [ProductName] is already installed." />
    <MediaTemplate EmbedCab="yes" />

    <!-- Add/Remove Programs presentation -->
    <Icon Id="AppIcon" SourceFile="assets\release_icon.ico" />
    <Property Id="ARPPRODUCTICON" Value="AppIcon" />
    <Property Id="ARPNOREPAIR" Value="1" />
    <Property Id="ARPNOMODIFY" Value="1" />

    <!-- Install locations -->
    <StandardDirectory Id="LocalAppDataFolder">
      <Directory Id="ProgramsFolder" Name="Programs">
        <Directory Id="INSTALLFOLDER" Name="RustOrigin Launcher" />
      </Directory>
    </StandardDirectory>
    <StandardDirectory Id="ProgramMenuFolder" />
    <StandardDirectory Id="DesktopFolder" />

    <ComponentGroup Id="AppComponents">
      <!-- The launcher exe (file is the component keypath) -->
      <Component Directory="INSTALLFOLDER" Id="LauncherExe" Guid="*">
        <File Id="RustOriginExe" Source="release\RustOrigin.exe" KeyPath="yes" />
      </Component>

      <!-- Shortcuts (per-user; HKCU registry value is the keypath, per MSI best practice) -->
      <Component Directory="INSTALLFOLDER" Id="AppShortcuts" Guid="*">
        <RegistryValue Root="HKCU" Key="Software\RustOrigin\Launcher"
                       Name="installed" Type="integer" Value="1" KeyPath="yes" />
        <Shortcut Id="StartMenuShortcut" Directory="ProgramMenuFolder"
                  Name="RustOrigin Launcher" Description="Launch RustOrigin"
                  Target="[#RustOriginExe]" WorkingDirectory="INSTALLFOLDER" Icon="AppIcon" />
        <Shortcut Id="DesktopShortcut" Directory="DesktopFolder"
                  Name="RustOrigin Launcher" Description="Launch RustOrigin"
                  Target="[#RustOriginExe]" WorkingDirectory="INSTALLFOLDER" Icon="AppIcon" />
      </Component>
    </ComponentGroup>

    <Feature Id="Main" Title="RustOrigin Launcher" Level="1">
      <ComponentGroupRef Id="AppComponents" />
    </Feature>
  </Package>
</Wix>
